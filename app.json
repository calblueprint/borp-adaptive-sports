{
  "expo": {
    "name": "borp-adaptive-sports",
    "slug": "borp-adaptive-sports",
    "owner": "calblueprint",
    "scheme": "borp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/bp-icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/bp-adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/bp-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/bp-splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-status-bar",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "BORP uses your location to show the trails closest to you and to pin new trailheads."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "BORP uses the microphone so you can leave voice notes while you survey a trail.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "BORP uses the camera so you can add photos while you survey a trail.",
          "photosPermission": "BORP lets you add photos from your library to trail pins."
        }
      ]
    ]
  }
}
