{
  "name": "borp-adaptive-sports",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint:check": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "prettier:check": "pnpm exec prettier --check .",
    "prettier:fix": "pnpm exec prettier --write .",
    "typecheck": "pnpm exec tsc --noEmit",
    "prepare": "husky",
    "pre-commit": "(pnpm run typecheck || true) && (pnpm run lint:check || true) && pnpm run prettier:check",
    "preinstall": "npx only-allow pnpm",
    "test": "jest"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@rneui/base": "4.0.0-rc.7",
    "@rneui/themed": "4.0.0-rc.8",
    "@supabase/supabase-js": "^2.53.0",
    "expo": "^58.0.20",
    "expo-constants": "~58.0.13",
    "expo-linking": "~58.0.14",
    "expo-location": "~58.0.19",
    "expo-router": "~58.0.27",
    "expo-sensors": "~58.0.4",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-url-polyfill": "^2.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.32.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.32.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.3",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "jest-expo": "~58.0.12",
    "prettier": "^3.6.2",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "yarnhook": "^0.6.2"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo"
  }
}
