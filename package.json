{
  "name": "borp-adaptive-sports",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint:check": "pnpm exec eslint .",
    "lint:fix": "pnpm exec eslint . --fix",
    "prettier:check": "pnpm exec prettier --check .",
    "prettier:fix": "pnpm exec prettier --write .",
    "typecheck": "pnpm exec tsc --noEmit",
    "gen:types": "pnpm dlx supabase gen types typescript --project-id txhzxdlcsjsoayosbjpb > api/supabase/database.types.ts && pnpm exec prettier --write api/supabase/database.types.ts",
    "prepare": "husky",
    "pre-commit": "(pnpm run typecheck || true) && (pnpm run lint:check || true) && pnpm run prettier:check",
    "preinstall": "npx only-allow pnpm"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.53.0",
    "expo": "^58.0.21",
    "expo-audio": "~58.0.11",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.14",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.15",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.28",
    "expo-splash-screen": "~58.0.12",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^9.32.0",
    "@expo/ngrok": "^4.1.0",
    "@ianvs/prettier-plugin-sort-imports": "^4.5.1",
    "@types/node": "^26.6.4",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^9.32.0",
    "eslint-config-expo": "~58.0.4",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.3",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "react-native-svg-transformer": "^1.5.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "yarnhook": "^0.6.2"
  },
  "private": true
}
